# ClawAIMail 配置

# === API 服务 ===
PORT=3000

# === 邮箱域名 ===
MAIL_DOMAIN=clawaimail.com

# === SMTP 收件服务器 ===
SMTP_LISTEN_PORT=2525
MAX_MESSAGE_SIZE=10485760
MAX_SMTP_CONNECTIONS=50

# TLS 证书（生产环境需要）
# TLS_KEY=/etc/letsencrypt/live/clawaimail.com/privkey.pem
# TLS_CERT=/etc/letsencrypt/live/clawaimail.com/fullchain.pem

# === 发件配置 ===
# 可选: smtp / resend / ses
MAIL_PROVIDER=smtp

# -- 方式1: 自定义 SMTP --
SMTP_HOST=smtp.gmail.com
SMTP_SEND_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# -- 方式2: Resend (推荐起步) --
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx

# -- 方式3: Amazon SES --
# MAIL_PROVIDER=ses
# SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SES_SMTP_USER=your-ses-smtp-user
# SES_SMTP_PASS=your-ses-smtp-pass

# === Stripe 计费 ===
# STRIPE_SECRET_KEY=sk_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_STARTER_PRICE_ID=price_xxx
# STRIPE_PRO_PRICE_ID=price_xxx
# STRIPE_BUSINESS_PRICE_ID=price_xxx
